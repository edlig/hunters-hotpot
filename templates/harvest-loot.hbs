<div class="hh-app-content" style="display: flex; flex-direction: column; height: 100%; max-height: 650px; position: relative;">
  
  <!-- Скроллируемый список компонентов -->
  <div style="flex: 1; overflow-y: auto; padding-bottom: 70px;">
    
    <!-- НОВАЯ МИСТИЧЕСКАЯ ПЛАШКА ЭССЕНЦИИ -->
    {{#if essObtained}}
      <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); border: 1px solid #8b5cf6; box-shadow: inset 0 0 12px rgba(139, 92, 246, 0.3), 0 4px 6px rgba(0,0,0,0.3); padding: 10px 12px; border-radius: 6px; margin-bottom: 15px; display: flex; align-items: center; gap: 12px;">
        <div style="position: relative;">
          <img src="{{essData.img}}" style="width: 36px; height: 36px; border-radius: 4px; object-fit: cover; border: 1px solid #c4b5fd; box-shadow: 0 0 8px #a78bfa;">
        </div>
        <div style="flex: 1;">
          <b style="color: #ddd6fe; font-size: 14px; text-shadow: 0 0 4px rgba(167, 139, 250, 0.8);">✨ Получена {{essData.name}}!</b><br>
          <span style="color: #a78bfa; font-size: 11px;">Качественное свежевание позволило извлечь первородную магию.</span>
        </div>
      </div>
    {{/if}}

    {{#each categories}}
      <div class="hh-cat-group" style="margin-bottom: 10px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; overflow: hidden;">
        <div style="background: #0f172a; padding: 6px 10px; border-bottom: 1px solid #334155; display: flex; align-items: center; gap: 8px;">
          <img src="{{this.img}}" style="width: 24px; height: 24px; border-radius: 4px; object-fit: cover;">
          <div style="flex: 1;">
            <b style="color: #f8fafc; font-size: 13px;">{{this.label}}</b><br>
            <span style="color: #94a3b8; font-size: 10px;">СЛ: {{this.dc}} | {{this.cLabel}}</span>
          </div>
        </div>
        <div style="padding: 6px;">
          {{#each this.rows}}
            <div class="hh-li hh-cascade-row {{#unless this.isFirst}}hidden-row{{/unless}}" data-cat="{{../id}}" style="{{#unless this.isFirst}}display:none;{{/unless}} align-items: center; justify-content: space-between; padding: 6px 0; border-bottom: 1px dashed #334155;">
              <div style="display: flex; align-items: center; gap: 8px; width: 60%;">
                
                {{!-- ЧЕКБОКС С ПРАВИЛЬНЫМИ ДАННЫМИ --}}
                <input type="checkbox" class="cb-slot" data-slots="{{this.slotsReq}}" data-w="{{this.w}}" data-p="{{this.p}}" {{#if (gt this.slotsReq ../../ctx.sizeData.s)}}disabled{{/if}} style="cursor: pointer; width: 16px; height: 16px;">
                
                <div style="display: flex; flex-direction: column; width: 100%;">
                  {{#if ../isUnique}}
                    <input type="text" class="hh-custom-val" placeholder="Особая деталь" style="height: 24px; font-size: 12px; border: 1px solid #475569; background: #0f172a; color: white; padding: 0 4px;">
                  {{else}}
                    <select class="hh-preset-sel" style="height: 24px; font-size: 11px; background: #0f172a; color: white; border: 1px solid #475569;">
                      {{#each ../presets}}<option value="{{this}}">{{this}}</option>{{/each}}
                      <option value="custom">-- Свое название --</option>
                    </select>
                    <input type="text" class="hh-custom-val" placeholder="Введите название..." style="display:none; height: 24px; font-size: 12px; margin-top: 4px; background: #0f172a; color: white; border: 1px solid #475569; padding: 0 4px;">
                  {{/if}}
                </div>
              </div>
              <div style="text-align: right; font-size: 11px; color: #94a3b8; line-height: 1.3;">
                {{#if this.isIndivisible}}
                  <span style="color: #fbbf24;">{{this.w}} lb</span> | {{this.p}} зм<br>
                  <span style="color: #ef4444; font-weight: bold;">Слотов: {{this.slotsReq}}</span>
                {{else}}
                  <span style="color: #10b981; font-weight: bold;">{{../../ctx.yieldPerSlot}} шт.</span> | <span style="color: #fbbf24;">{{this.p}} зм/шт</span><br>
                  <span style="color: #94a3b8;">1 слот ({{this.w}} lb/шт)</span>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    {{/each}}
  </div>

  <!-- ЗАКРЕПЛЕННАЯ ПАНЕЛЬ СЛОТОВ И КНОПКИ -->
  <div style="position: sticky; bottom: -8px; margin: 0 -8px -8px -8px; background: #0f172a; border-top: 2px solid #38bdf8; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 -10px 15px -3px rgba(0, 0, 0, 0.5);">
    
    <div style="display: flex; flex-direction: column; max-width: 50%;">
      <span style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Цель сбора</span>
      <b style="color: #f8fafc; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ctx.mName}}</b>
    </div>
    
    <div style="display: flex; align-items: center; gap: 20px;">
      <div style="text-align: right; background: #1e293b; padding: 4px 10px; border-radius: 6px; border: 1px solid #334155;">
        <span style="color: #94a3b8; font-size: 10px; text-transform: uppercase;">Слоты</span><br>
        <b id="hh-used" style="color: #10b981; font-size: 18px;">0</b>
        <span style="color: #64748b; font-size: 14px;">/ {{ctx.sizeData.s}}</span>
      </div>
      
      <button type="submit" style="background: #10b981; color: #f8fafc; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px; box-shadow: 0 4px 6px rgba(16, 185, 129, 0.2); transition: 0.2s;">
        <i class="fas fa-hand-holding"></i> Взять
      </button>
    </div>

  </div>
</div>