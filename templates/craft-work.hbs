<div style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
    
    <!-- Шапка проекта -->
    <div style="background: #0f172a; padding: 10px; border-radius: 6px; border: 1px solid #334155; text-align: center;">
        <h3 style="margin: 0 0 4px; color: #38bdf8; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{itemName}}</h3>
        <div style="font-size: 12px; color: #94a3b8;">Прогресс: <b style="color: #10b981;">{{current}}</b> / {{target}} ч. (СЛ {{dc}})</div>
    </div>

    <!-- Инструменты и Характеристики -->
    <div style="background: #1e293b; padding: 10px; border-radius: 6px; border: 1px solid #334155;">
        
        {{#if hasTools}}
            <label style="font-size: 11px; font-weight: bold; color: #94a3b8; display: block; margin-bottom: 4px;">Инструмент для работы:</label>
            <select id="tool-sel" name="toolId" style="width: 100%; margin-bottom: 8px; background: #0f172a; color: white; border: 1px solid #475569; font-size: 13px;">
                {{#each tools}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>

            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 12px; color: #f8fafc; margin-bottom: 8px;">
                <input type="checkbox" id="prof-cb" name="hasProf" {{#if isProficient}}checked{{/if}} style="width:14px; height:14px;">
                Владение инструментом (+{{pb}} к броску)
            </label>
        {{else}}
            <div style="background: #fee2e2; padding: 8px; border-radius: 4px; border: 1px solid #f87171; color: #991b1b; font-size: 11px; text-align: center; margin-bottom: 8px;">
                У вас нет инструментов! Вы работаете без бонуса мастерства.
            </div>
        {{/if}}

        <label style="font-size: 11px; font-weight: bold; color: #94a3b8; display: block; margin-bottom: 4px;">Характеристика:</label>
        <select name="statId" style="width: 100%; background: #0f172a; color: white; border: 1px solid #475569; font-size: 13px;">
            {{#each statOptions}}
                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </div>

    <!-- Параметры сессии -->
    <div style="display: flex; gap: 10px; align-items: center;">
        <div style="flex: 1;">
            <label style="font-size: 11px; font-weight: bold; color: #94a3b8; display: block; margin-bottom: 4px;">Часов работы (Макс: {{maxHours}}):</label>
            <input type="number" name="hours" min="1" max="{{maxHours}}" value="{{lastHours}}" style="width: 100%; height: 28px; background: #0f172a; color: white; border: 1px solid #475569; text-align: center; font-weight: bold;">
        </div>
    </div>

    <!-- Помощник -->
    <div style="background: #1e293b; padding: 8px; border-radius: 6px; border: 1px solid #334155;">
        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 12px; color: #f8fafc;">
            <input type="checkbox" name="hasHelper" style="width:14px; height:14px;"> Есть помощник (Удваивает часы)
        </label>
    </div>

    <button type="submit" id="submit-btn" style="width: 100%; background: #10b981; color: white; border: none; padding: 10px; border-radius: 4px; cursor: pointer; font-weight: bold; transition: 0.2s; font-size: 14px;">
        <i class="fas fa-hammer"></i> Работать
    </button>
</div>